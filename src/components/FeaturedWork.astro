---
// Compact home page teaser; the full grid lives on /work/.
import { projects, projectPath } from '../data/projects';
---

<section id="case-studies" class="py-16 sm:py-20" aria-labelledby="featured-work-heading">
  <div class="site-container">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-[.16em] text-rose-300">Selected work</span>
        <h2 id="featured-work-heading" class="mt-2 text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          Featured <span class="text-gradient-rose">case studies</span>
        </h2>
      </div>
      <a href="/work/" class="text-sm font-bold text-rose-300 hover:text-rose-200 underline underline-offset-4">View all work →</a>
    </div>

    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {projects.map((project) => (
        <li>
          <a href={projectPath(project)} class="glass-panel group flex h-full flex-col overflow-hidden border border-white/10 hover:border-rose-400/40">
            <div class="aspect-[16/10] overflow-hidden bg-slate-950">
              <img
                src={project.image}
                alt=""
                width="1376"
                height="768"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <span class="text-[11px] font-bold uppercase tracking-wider text-rose-300 mb-1">{project.client}</span>
              <h3 class="text-base font-bold text-white leading-snug group-hover:text-rose-200 transition-colors">{project.title}</h3>
              <span class="mt-auto pt-3 text-xs text-slate-400">{project.category}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
