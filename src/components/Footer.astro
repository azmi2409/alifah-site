---
// Footer.astro
import BrandLogo from './BrandLogo.astro';
import { navItems, WHATSAPP_URL, LINKEDIN_URL, EMAIL } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-slate-950/80 backdrop-blur-md py-12 relative overflow-hidden">
  <div class="site-container">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      
      {/* Consistent Brand Logo */}
      <a href="/" aria-label="Alifah Azhar Home" class="transition-opacity hover:opacity-90">
        <BrandLogo size="md" />
      </a>

      {/* Nav Links Matching Header */}
      <nav aria-label="Footer">
        <ul class="flex flex-wrap items-center justify-center gap-6 text-sm font-medium text-slate-400">
          <li><a href="/" class="hover:text-rose-300 transition-colors">Home</a></li>
          {navItems.map((item) => (
            <li><a href={item.href} class="hover:text-rose-300 transition-colors">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      {/* Socials & Copyright */}
      <div class="flex flex-col sm:flex-row items-center gap-4 text-xs text-slate-500">
        <div class="flex items-center gap-3 text-slate-400">
          <a 
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-emerald-400 transition-colors p-1"
            title="WhatsApp" aria-label="WhatsApp"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </a>
          <a 
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-sky-400 transition-colors p-1"
            title="LinkedIn" aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
            </svg>
          </a>
          <a 
            href={`mailto:${EMAIL}`}
            class="hover:text-rose-400 transition-colors p-1"
            title="Email" aria-label="Email"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path>
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            </svg>
          </a>
        </div>

        <span>•</span>
        <span>© {year} Alifah Azhar. All rights reserved.</span>

        <a href="#top" class="text-rose-300 hover:text-rose-200 font-medium transition-colors ml-1">
          ↑ Top
        </a>
      </div>

    </div>
  </div>
</footer>
