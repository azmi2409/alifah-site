---
// Hero.astro
---

<section class="hero-section">
  <div class="container">
    <div class="hero-grid">
      <!-- Left Column: Copy & CTAs -->
      <div class="hero-content">
        <!-- Status Pill -->
        <div class="hero-badge-group">
          <span class="badge badge-emerald">
            <span class="pulse-dot"></span>
            Available for Projects & Full-time
          </span>
          <span class="badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            Bekasi, West Java, ID
          </span>
        </div>

        <!-- Headline -->
        <h1 class="hero-title">
          Hi, I'm <span class="gradient-text">Alifah Azhar</span>.
        </h1>

        <p class="hero-role">
          Performance Marketer & Meta Ads Specialist
        </p>

        <!-- Subheadline / Value Proposition -->
        <p class="hero-description">
          Bridging financial analytical rigor and paid acquisition. Former commercial banker now working with Meta Ads, creative A/B testing, and Looker Studio reporting.
        </p>

        <!-- CTAs -->
        <div class="hero-actions">
          <a href="#case-studies" class="btn-primary">
            <span>View Case Studies</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a 
            href="https://wa.me/6281259488390?text=Hi%20Alifah,%20I%20saw%20your%20portfolio%20and%20would%20love%20to%20discuss%20a%20digital%20marketing%20project!" 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn-whatsapp"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>Chat on WhatsApp</span>
          </a>

          <button id="copy-email-btn" class="btn-secondary" title="Copy Email">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="email-btn-text">alifahazhar@gmail.com</span>
          </button>
        </div>

        <!-- Quick Links / Credentials -->
        <div class="hero-socials">
          <span class="social-label">Connect & Verify:</span>
          <div class="social-pills">
            <a 
              href="https://www.linkedin.com/in/alifahazhar" 
              target="_blank" 
              rel="noopener noreferrer"
              class="social-link"
              title="Alifah on LinkedIn"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
              LinkedIn Profile
            </a>

            <span class="social-divider">•</span>

            <span class="credential-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              RevoU Full Stack Certified
            </span>

            <span class="social-divider">•</span>

            <span class="credential-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
              IPB Graduate
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column: Profile Visual & Badges -->
      <div class="hero-visual">
        <div class="image-wrapper">
          <!-- Background Glow Effect -->
          <div class="image-glow"></div>
          
          <!-- Image Container -->
          <div class="image-card">
            <img 
              src="/images/alifah.webp" 
              alt="Alifah Azhar Nurhazmi - Performance Marketer & Meta Ads Specialist" 
              width="460" 
              height="460" 
              class="hero-img"
              loading="eager"
            />
          </div>

          <!-- Floating Badges -->
          <div class="floating-badge badge-top-right glass-card">
            <div class="badge-icon-box gold">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
            <div class="badge-text-box">
              <span class="badge-metric">Top 3 Award</span>
              <span class="badge-caption">Account Officer 2020</span>
            </div>
          </div>

          <div class="floating-badge badge-bottom-left glass-card">
            <div class="badge-icon-box emerald">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
              </svg>
            </div>
            <div class="badge-text-box">
              <span class="badge-metric">Meta Ads Pro</span>
              <span class="badge-caption">Audience & A/B Testing</span>
            </div>
          </div>

          <div class="floating-badge badge-bottom-right glass-card">
            <div class="badge-icon-box blue">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <div class="badge-text-box">
              <span class="badge-metric">Data Studio</span>
              <span class="badge-caption">100% KPI Tracking</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 8rem;
    padding-bottom: 4.5rem;
    position: relative;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-badge-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .hero-role {
    font-size: clamp(1.15rem, 2.5vw, 1.4rem);
    font-weight: 600;
    color: var(--primary-light);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2.25rem;
    max-width: 600px;
  }

  .hero-description strong {
    color: var(--text-primary);
  }

  .highlight-text {
    color: var(--accent-emerald-light);
    font-weight: 700;
    background: rgba(16, 185, 129, 0.1);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }

  .hero-socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .social-label {
    font-size: 0.825rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .social-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  .social-link:hover {
    background: rgba(56, 189, 248, 0.18);
    color: #7dd3fc;
  }

  .social-divider {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .credential-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.825rem;
    color: var(--text-secondary);
  }

  /* Right Column Visuals */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    max-width: 420px;
  }

  .image-glow {
    position: absolute;
    inset: -15px;
    background: radial-gradient(circle at center, rgba(99, 102, 241, 0.4), rgba(16, 185, 129, 0.15), transparent 70%);
    border-radius: 36px;
    filter: blur(25px);
    z-index: 1;
  }

  .image-card {
    position: relative;
    z-index: 2;
    border-radius: 32px;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.12);
    box-shadow: var(--shadow-lg), 0 0 50px rgba(99, 102, 241, 0.25);
    background: #111827;
    aspect-ratio: 1 / 1;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .image-card:hover .hero-img {
    transform: scale(1.03);
  }

  /* Floating Badges */
  .floating-badge {
    position: absolute;
    z-index: 5;
    padding: 0.65rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: var(--radius-md);
    background: rgba(16, 23, 38, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: var(--shadow-md);
    animation: floatSlow 5s ease-in-out infinite alternate;
  }

  .badge-top-right {
    top: -12px;
    right: -15px;
    animation-delay: 0s;
  }

  .badge-bottom-left {
    bottom: -15px;
    left: -15px;
    animation-delay: 1.5s;
  }

  .badge-bottom-right {
    bottom: 45px;
    right: -25px;
    animation-delay: 2.5s;
  }

  .badge-icon-box {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .badge-icon-box.gold {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
  }

  .badge-icon-box.emerald {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
  }

  .badge-icon-box.blue {
    background: rgba(0, 129, 251, 0.15);
    color: #60a5fa;
  }

  .badge-text-box {
    display: flex;
    flex-direction: column;
  }

  .badge-metric {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .badge-caption {
    font-size: 0.7rem;
    color: var(--text-secondary);
    line-height: 1.2;
  }

  @keyframes floatSlow {
    0% {
      transform: translateY(0px);
    }
    100% {
      transform: translateY(-6px);
    }
  }

  /* Responsive Adjustments */
  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2.5rem;
    }

    .hero-badge-group,
    .hero-actions,
    .hero-socials,
    .social-pills {
      justify-content: center;
    }

    .hero-description {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-visual {
      order: -1;
    }

    .image-wrapper {
      max-width: 320px;
    }

    .floating-badge {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions a,
    .hero-actions button {
      width: 100%;
    }
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const emailText = 'alifahazhar@gmail.com';

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailText);
        if ((window as any).showToast) {
          (window as any).showToast('Email copied to clipboard!');
        }
      } catch (err) {
        // fallback
        const textarea = document.createElement('textarea');
        textarea.value = emailText;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        if ((window as any).showToast) {
          (window as any).showToast('Email copied to clipboard!');
        }
      }
    });
  }
</script>
