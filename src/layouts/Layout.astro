---
import '../styles/global.css';
import { SITE_URL, PERSON_NAME, JOB_TITLE, EMAIL, LINKEDIN_URL, absoluteUrl } from '../data/site';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  ogType?: 'profile' | 'website' | 'article';
  /** schema.org type of this page's WebPage node */
  pageType?: 'ProfilePage' | 'WebPage' | 'CollectionPage' | 'ContactPage' | 'AboutPage';
  /** Trail after Home, used for BreadcrumbList structured data */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD nodes appended to the page graph */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = `${PERSON_NAME} | ${JOB_TITLE}`,
  description = `Portfolio of ${PERSON_NAME} — ${JOB_TITLE}. Former commercial banker combining financial discipline with Meta Ads, A/B creative testing, and Looker Studio reporting.`,
  canonicalUrl = absoluteUrl(Astro.url.pathname),
  ogImage = absoluteUrl('/images/alifah.webp'),
  ogImageWidth = 800,
  ogImageHeight = 800,
  ogImageAlt = `${PERSON_NAME} - ${JOB_TITLE}`,
  ogType = 'website',
  pageType = 'WebPage',
  breadcrumbs = [],
  schema = [],
  noindex = false,
} = Astro.props;

const ogImageType = ogImage.endsWith('.jpg') || ogImage.endsWith('.jpeg') ? 'image/jpeg' : ogImage.endsWith('.png') ? 'image/png' : 'image/webp';
const personId = `${SITE_URL}/#person`;
const websiteId = `${SITE_URL}/#website`;
const breadcrumbId = `${canonicalUrl}#breadcrumb`;

// JSON-LD graph for search engines and AI answer engines (Google AI Overviews, ChatGPT, Perplexity, Gemini, Copilot)
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      "url": `${SITE_URL}/`,
      "name": `${PERSON_NAME} — Portfolio`,
      "alternateName": "Alifah Azhar Portfolio",
      "description": `Portfolio of ${PERSON_NAME}, ${JOB_TITLE} based in Bekasi, Indonesia.`,
      "inLanguage": "en-US",
      "publisher": { "@id": personId }
    },
    {
      "@type": pageType,
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "inLanguage": "en-US",
      "isPartOf": { "@id": websiteId },
      "about": { "@id": personId },
      ...(pageType === 'ProfilePage' ? { "mainEntity": { "@id": personId } } : {}),
      "primaryImageOfPage": { "@type": "ImageObject", "url": ogImage, "width": ogImageWidth, "height": ogImageHeight },
      ...(breadcrumbs.length ? { "breadcrumb": { "@id": breadcrumbId } } : {})
    },
    ...(breadcrumbs.length ? [{
      "@type": "BreadcrumbList",
      "@id": breadcrumbId,
      "itemListElement": [{ name: 'Home', path: '/' }, ...breadcrumbs].map((crumb, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": crumb.name,
        "item": absoluteUrl(crumb.path)
      }))
    }] : []),
    {
      "@type": "Person",
      "@id": personId,
      "name": PERSON_NAME,
      "givenName": "Alifah Azhar",
      "familyName": "Nurhazmi",
      "alternateName": ["Alifah Azhar", "Alifah"],
      "jobTitle": JOB_TITLE,
      "description": "Former commercial banker now working in performance marketing through Meta Ads, A/B creative testing, and Looker Studio reporting.",
      "url": `${SITE_URL}/`,
      "image": {
        "@type": "ImageObject",
        "url": absoluteUrl('/images/alifah.webp'),
        "width": 800,
        "height": 800,
        "caption": `${PERSON_NAME} - ${JOB_TITLE}`
      },
      "email": `mailto:${EMAIL}`,
      "telephone": "+6281259488390",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Bekasi",
        "addressRegion": "West Java",
        "addressCountry": "ID"
      },
      "knowsLanguage": ["id", "en"],
      "sameAs": [LINKEDIN_URL],
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "Bogor Agricultural University (IPB)",
          "sameAs": "https://ipb.ac.id"
        },
        {
          "@type": "EducationalOrganization",
          "name": "RevoU",
          "description": "Full Stack Digital Marketing (FSDM)"
        }
      ],
      "hasOccupation": {
        "@type": "Occupation",
        "name": JOB_TITLE,
        "occupationLocation": { "@type": "Country", "name": "Indonesia" },
        "skills": "Meta Ads Manager, campaign budget optimization, A/B creative testing, audience segmentation, Looker Studio reporting, ROAS and CPA analysis"
      },
      "knowsAbout": [
        "Meta Ads Manager",
        "Performance Marketing",
        "Paid Social Advertising",
        "Campaign Budget Optimization (CBO)",
        "Ad Set Budget Optimization (ABO)",
        "Looker Studio / Google Data Studio",
        "ROAS Attribution & CPA Optimization",
        "A/B Creative & Hook Testing",
        "Audience Segmentation & Custom Audiences",
        "Commercial Banking & Credit Risk Analysis"
      ],
      "award": [
        "Top 3 Best Achievement Account Officer PT Bank BRISyariah Tbk (2020)"
      ]
    },
    ...schema
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0c0a12" />
    <meta name="color-scheme" content="light dark" />

    <!-- Resolve theme before first paint to avoid a flash of the wrong theme -->
    <script is:inline>
      (() => {
        let pref = 'system';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark' || stored === 'system') pref = stored;
        } catch {}
        const theme = pref === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : pref;
        const root = document.documentElement;
        root.dataset.themePref = pref;
        root.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#0c0a12' : '#fbf7f4');
      })();
    </script>
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Search Engine Optimization (SEO) -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Alifah Azhar Nurhazmi" />
    <meta name="keywords" content="Alifah Azhar, Alifah Azhar Nurhazmi, Meta Ads Specialist, Facebook Ads Specialist, Digital Marketer Indonesia, Performance Marketing, RevoU, Bogor Agricultural University, Looker Studio Reporting, CBO, ABO, Paid Acquisition" />
    
    <!-- Search Engine Indexing & Bot Directives -->
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    {!noindex && <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}
    {!noindex && <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}
    
    <!-- AI Optimization (AIO / GEO) Discovery Links -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context Summary" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Alifah Azhar Portfolio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:type" content={ogImageType} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Mobile App & Browser UI Optimization -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Alifah Azhar" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Structured Data: JSON-LD for Search Engines and AI Crawlers (AIO) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Google Fonts Preconnect & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body id="top">
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <slot />

    <!-- Toast Notification element -->
    <div id="toast" class="toast-notice" role="alert" aria-live="polite">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
      <span id="toast-message">Copied to clipboard!</span>
    </div>

    <script>
      // Reading progress
      const updateProgress = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        document.documentElement.style.setProperty('--progress', String(max > 0 ? Math.min(scrollY / max, 1) : 0));
      };
      addEventListener('scroll', updateProgress, { passive: true });
      addEventListener('resize', updateProgress);
      updateProgress();

      // Global toast helper
      let toastTimer: any = null;
      (window as any).showToast = (msg: string) => {
        const toast = document.getElementById('toast');
        const msgEl = document.getElementById('toast-message');
        if (toast && msgEl) {
          msgEl.textContent = msg;
          toast.classList.add('show');
          if (toastTimer) clearTimeout(toastTimer);
          toastTimer = setTimeout(() => {
            toast.classList.remove('show');
          }, 2600);
        }
      };
    </script>
  </body>
</html>
